# Copy to .env.local for local dev, or set in Vercel's project env vars for
# production. Neither is required for the site to run -- without
# BREVO_API_KEY, /api/subscribe logs a warning and still reveals the
# download (fails open, never blocks a real visitor).

# Brevo (brevo.com) API key -- Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=

# Optional. A Brevo list ID to add contacts to. Without it, contacts still
# land in Brevo's main contact pool, just not pre-segmented into a list.
# Create a list in Brevo's dashboard once you want one, then set this --
# no code change needed.
BREVO_LIST_ID=
